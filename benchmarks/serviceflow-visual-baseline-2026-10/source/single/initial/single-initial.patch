diff --git a/src/client/information.tsx b/src/client/information.tsx
new file mode 100644
index 0000000..69b1e20
--- /dev/null
+++ b/src/client/information.tsx
@@ -0,0 +1,84 @@
+import { Link } from "react-router-dom";
+export function Information({ privacy = false }: { privacy?: boolean }) {
+  return (
+    <article className="container information-page">
+      <Link to="/" className="back-link">
+        ← Back home
+      </Link>
+      <h1>{privacy ? "Your data in this demo" : "About Hearth & Home"}</h1>
+      {privacy ? (
+        <>
+          <p>
+            ServiceFlow is a local portfolio demonstration. Use the supplied
+            demo accounts and synthetic information only.
+          </p>
+          <h2>What is stored</h2>
+          <p>
+            The local SQLite database stores accounts, sessions, service
+            requests, contact details and activity history. Authentication uses
+            a session cookie. Your unfinished request and retry information are
+            kept in browser session storage, scoped to your account. Signing out
+            clears that browser storage.
+          </p>
+          <h2>Who can view a request</h2>
+          <p>
+            Customers can see their own enquiries. Authorised provider and
+            administrator accounts can review requests for this fictional
+            business. Administrators also manage the service catalogue.
+          </p>
+          <h2>Draft replies</h2>
+          <p>
+            This local demo uses deterministic draft replies without a live AI
+            credential. If an owner configures the optional AI adapter, it sends
+            service and job information to OpenAI. Contact fields, location,
+            identifiers and history are excluded, and email and phone patterns
+            in descriptions are redacted. Freely typed personal details may not
+            be fully anonymised, so keep all information synthetic. Replies are
+            reviewed and copied manually. This app does not send messages.
+          </p>
+          <h2>Local demonstration only</h2>
+          <p>
+            No payments, live appointments, public registration or real service
+            bookings are available. This page describes the local demonstration,
+            rather than a policy for a public service.
+          </p>
+        </>
+      ) : (
+        <>
+          <p>
+            Hearth & Home is the fictional Bristol home-services business used
+            to demonstrate ServiceFlow. Its catalogue covers repairs, garden
+            care, painting and cleaning.
+          </p>
+          <h2>Try the complete workflow</h2>
+          <p>
+            Customers submit an enquiry and follow its progress. Providers
+            review requests, update their status and prepare draft replies.
+            Administrators manage the catalogue and its activity log.
+          </p>
+          <p>
+            All sample accounts and enquiries are fictional. Indicative prices
+            are demonstration content. Choosing a date does not make a real
+            appointment.
+          </p>
+          <h2>Project ownership</h2>
+          <p>
+            ServiceFlow is an{" "}
+            <a
+              href="https://www.aethdesign.com/"
+              target="_blank"
+              rel="noreferrer"
+            >
+              AethDesign portfolio demonstration
+            </a>
+            . AethDesign is the software and interface studio, not the
+            home-services provider. No client relationship is claimed.
+          </p>
+          <Link to="/login" className="button">
+            Explore a demo account
+          </Link>
+        </>
+      )}
+    </article>
+  );
+}
