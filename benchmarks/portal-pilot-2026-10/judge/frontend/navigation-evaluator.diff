+// Navigation is determined by visible authenticated UI after startup/reload.
+// Retained detail routes may leave overview controls mounted but hidden.
+export async function settledAuthenticatedView(page){
+ await eventually(async()=>await hook(page,'logout').isVisible().catch(()=>false)&&
+  (await hook(page,'project-detail').isVisible().catch(()=>false)||await hook(page,'project-list').isVisible().catch(()=>false)),
+  'authenticated overview or detail settles');
+}
+export async function ensureProjectDetail(page,id){
+ await settledAuthenticatedView(page);
+ if(await hook(page,'project-detail').isVisible().catch(()=>false)){
+  if(await hook(page,'project-detail').getAttribute('data-project-id')===id){await visible(page,'project-title');return;}
+  await visible(page,'back-projects');await hook(page,'back-projects').click();await visible(page,'project-list');
+ }
+ const el=page.locator(`[data-testid="open-project"][data-project-id="${id}"]`).first();await el.click();
+ await eventually(async()=>await hook(page,'project-detail').isVisible().catch(()=>false)&&await hook(page,'project-detail').getAttribute('data-project-id')===id,'correct project detail');
+ await visible(page,'project-title');
+}
+const open=ensureProjectDetail;
+async function tab(page,id){
+ const control=hook(page,`tab-${id}`);
+ const selected=await control.getAttribute('aria-selected')!==null;
+ const current=await page.locator('[data-testid^="tab-"][aria-current]').count()>0;
+ await control.click();
+ if(selected)await eventually(async()=>await control.getAttribute('aria-selected')==='true','selected project tab settles');
+ else if(current)await eventually(async()=>await control.getAttribute('aria-current')==='page','current project tab settles');
+}
