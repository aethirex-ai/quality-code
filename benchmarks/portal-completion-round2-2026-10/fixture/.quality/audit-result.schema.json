{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/agent-quality/audit-result.schema.json",
  "title": "Independent code audit result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict",
    "scope",
    "risk",
    "checks",
    "findings",
    "untested",
    "residual_risk",
    "worktree_unchanged"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "verdict": { "enum": ["PASS", "FAIL", "BLOCKED"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "changed_files", "acceptance_criteria"],
      "properties": {
        "base": { "type": "string", "minLength": 1 },
        "changed_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "acceptance_criteria": { "type": "string", "minLength": 1 }
      }
    },
    "risk": { "enum": ["critical", "high", "normal", "low"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "exit_code", "evidence"],
        "properties": {
          "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "status": { "enum": ["pass", "fail", "not_run"] },
          "exit_code": { "type": ["integer", "null"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "title", "file", "line", "evidence", "required_action"],
        "properties": {
          "id": { "type": "string", "pattern": "^AUD-[0-9]{3}$" },
          "severity": { "enum": ["critical", "high", "normal", "low"] },
          "title": { "type": "string", "minLength": 1 },
          "file": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "required_action": { "type": "string", "minLength": 1 }
        }
      }
    },
    "untested": { "type": "array", "items": { "type": "string" } },
    "residual_risk": { "type": "string", "minLength": 1 },
    "worktree_unchanged": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "verdict": { "const": "PASS" } } },
      "then": {
        "type": "object",
        "properties": {
          "worktree_unchanged": { "const": true },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "status": { "const": "pass" } }
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "severity": { "enum": ["normal", "low"] } }
            }
          }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "verdict": { "const": "FAIL" } } },
      "then": {
        "type": "object",
        "properties": { "findings": { "type": "array", "minItems": 1 } }
      }
    }
  ]
}
