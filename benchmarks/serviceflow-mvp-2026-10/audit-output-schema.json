{
  "title": "Independent code audit result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict",
    "scope",
    "risk",
    "checks",
    "findings",
    "untested",
    "residual_risk",
    "worktree_unchanged"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ],
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "changed_files",
        "acceptance_criteria"
      ],
      "properties": {
        "base": {
          "type": "string",
          "const": "HEAD"
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria": {
          "type": "string",
          "const": "ServiceFlow acceptance SHA256 0568ce48ebad5f2aec6139f2f3345acf63065eb403a10d81d69a08b36ae91abf"
        }
      }
    },
    "risk": {
      "type": "string",
      "const": "critical"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "status",
          "exit_code",
          "evidence"
        ],
        "properties": {
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ],
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "title",
          "file",
          "line",
          "evidence",
          "required_action"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "normal",
              "low"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "required_action": {
            "type": "string"
          }
        }
      }
    },
    "untested": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residual_risk": {
      "type": "string"
    },
    "worktree_unchanged": {
      "type": "boolean"
    }
  }
}
