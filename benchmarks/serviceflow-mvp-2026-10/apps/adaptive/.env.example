# Local demo defaults work without copying this file. Node 24.15+ required.
PORTAL_PORT=3000
DATABASE_PATH=./data/serviceflow.sqlite
# Optional local session signing override (server only). Without it, a random
# local secret is generated once alongside the database and reused on restart.
BETTER_AUTH_SECRET=
# Optional configured provider, NEVER used in benchmark or tests against a live service.
AI_API_KEY=
AI_API_URL=
AI_MODEL=
