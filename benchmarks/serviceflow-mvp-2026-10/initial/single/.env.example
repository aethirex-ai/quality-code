# Local only. benchmark:start uses PORTAL_PORT when provided.
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=./data/serviceflow.sqlite
# Optional locally generated secret; when empty, a random persistent local secret is created.
BETTER_AUTH_SECRET=
# Leave blank for deterministic demo drafts. No live requests are used during verification.
AI_API_KEY=
AI_MODEL=
