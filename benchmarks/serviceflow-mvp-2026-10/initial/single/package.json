{
  "name": "serviceflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --import tsx src/server/start.ts",
    "benchmark:start": "npm run start",
    "start": "node dist/server/start.js",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && esbuild src/server/start.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server/start.js",
    "verify:full": "npm run typecheck && npm test",
    "verify:release": "npm run build && npm run test:process",
    "test:e2e": "python3 scripts/e2e.py",
    "test:process": "node --import tsx scripts/process-smoke.ts",
    "format:check": "prettier --check src tests scripts/*.ts vite.config.ts vitest.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
