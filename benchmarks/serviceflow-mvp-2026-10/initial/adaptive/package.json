{
  "name": "serviceflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "node --import tsx src/server/index.ts",
    "benchmark:start": "node --import tsx src/server/index.ts --production",
    "start": "node --import tsx src/server/index.ts --production",
    "migrate": "node --import tsx src/server/migrate.ts",
    "seed": "node --import tsx src/server/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "test:e2e": "python3 scripts/browser_checks.py",
    "format": "prettier --write src tests vite.config.ts tsconfig.json index.html",
    "format:check": "prettier --check src tests vite.config.ts tsconfig.json index.html",
    "test:setup": "python3 scripts/fresh_setup.py"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
